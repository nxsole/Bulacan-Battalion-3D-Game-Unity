  m_Script: {fileID: 11500000, guid: 8f472df1974c4734698e9c880f1d13d7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameOutcomeManager
  allyTag: Ally
  blackOverlay: {fileID: 1250898186}
  outcomeText: {fileID: 497231411}
  loseMessage: "When the First Philippine Republic decentralized into localized guerrilla
    militias on November 13, 1899, it severely limited Aguinaldo\u2019s ability to
    command. As he fled north, several groups were lost to the battle trying to link
    up with him."
  loseBlackFadeIn: 1
  loseTypeSpeed: 0.05
  loseHoldAfterTyped: 3
  loseStinger: {fileID: 0}
  winMessage: The trek officially began on November 13, 1899.
  winPanDistance: 6
  winPanDuration: 12
  winTextDelay: 1.5
  winTypeSpeed: 0.15
  winHoldAfterTyped: 2
  winBlackFadeIn: 2
  winStinger: {fileID: 0}
  winSecondMessage: "President Emilio Aguinaldo made the critical decision to disband
    the regular Filipino army. He ordered his generals to split into localized guerrilla
    units while he, along with a small presidential escort\u2014which included General
    Gregorio del Pilar\u2014fled north."
  winSecondTextDelay: 0.6
  winSecondTextHold: 3
  winSecondText: {fileID: 497231411}
  stingerSource: {fileID: 0}
  mainMenuSceneName: main menu
  delayBeforeMenu: 3
  debugLogging: 1
