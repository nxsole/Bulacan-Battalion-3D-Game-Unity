  backgroundMusic: {fileID: 8300000, guid: fded81278156d1c4387c79edbb936405, type: 3}
  bgmVolume: 0.28
  bgmFadeOutDuration: 1.5
  textTypingSpeed: 0.035
  dialogueSequence:
  - speakerName: American 1
    speakerColor: {r: 1, g: 0.653292, b: 0, a: 1}
    dialogueText: "That general up on the ridge\u2014del Pilar. He\u2019s holding
      the entire pass with a handful of sharpshooters. If we take him down, their
      front collapses!"
    voiceClip: {fileID: 8300000, guid: 74aea0039e08bc2468788ce713180f86, type: 3}
    delayAfterLine: 1.5
  - speakerName: American 2
    speakerColor: {r: 1, g: 0.654902, b: 0, a: 1}
    dialogueText: "He\u2019s holding his position near the barricades up ahead, Major.
      The road is completely open, so we'll need to move rock-to-rock and flush him
      out!"
    voiceClip: {fileID: 8300000, guid: c19d3fae54f365e41bf5216eaf546b5c, type: 3}
    delayAfterLine: 2
