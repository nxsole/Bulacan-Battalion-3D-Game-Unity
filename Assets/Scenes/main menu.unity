--- !u!114 &1974890262
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1974890261}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3a14f59a8ca1a984dabf62c5b31a33ea, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TiradPass.TiradPassIntroCutscene
  mainCamera: {fileID: 330585545}
  mainMenuCanvasGroup: {fileID: 1231733112}
  speakerNameText: {fileID: 2043483214}
  dialogueContentText: {fileID: 897234915}
  dialogueCanvasGroup: {fileID: 233156805}
  screenFadeCanvasGroup: {fileID: 1058323547}
  skipButton: {fileID: 9025551}
  cameraMoveSpeed: 1
  cameraRotateSpeed: 1
  mainMenuMusicSource: {fileID: 1689236407}
  campfireAudioSource: {fileID: 1158658941}
  nightAmbienceAudioSource: {fileID: 342136737}
  dialogueVoiceSource: {fileID: 1756282025}
  audioFadeDuration: 1.5
  textTypingSpeed: 0.035
  nextSceneName: Level 1
  fadeDuration: 2
  mainMenuCamTarget: {fileID: 1486672035}
  goyoCamTarget: {fileID: 36065401}
  sundalo1CamTarget: {fileID: 1441728290}
  sundalo2CamTarget: {fileID: 28174540}
  wideShotCamTarget: {fileID: 1878330690}
  dialogueSequence:
  - speakerName: GOYO
    speakerColor: {r: 0.95, g: 0.75, b: 0.3, a: 1}
    dialogueText: Magpahinga muna kayo. Mahaba pa ang lalakbayin natin ngayong gabi.
    cameraTarget: {fileID: 36065401}
    voiceClip: {fileID: 8300000, guid: ec20e88383f7ae5489fd7125de234c76, type: 3}
    delayAfterLine: 1
    customMoveSpeed: 1
    customRotateSpeed: 1
  - speakerName: SUNDALO 1
    speakerColor: {r: 0.85, g: 0.85, b: 0.85, a: 1}
    dialogueText: Goyo, sigurado ka bang ligtas ang daan?
    cameraTarget: {fileID: 1441728290}
    voiceClip: {fileID: 8300000, guid: c6942ff9c7d3d16468364aa0b3614464, type: 3}
    delayAfterLine: 1
    customMoveSpeed: 1
    customRotateSpeed: 1
  - speakerName: SUNDALO 2
    speakerColor: {r: 0.7, g: 0.85, b: 0.95, a: 1}
    dialogueText: Naririnig ko pa rin ang mga putok. Hinahabol pa rin tayo ng mga
      Amerikano.
    cameraTarget: {fileID: 28174540}
    voiceClip: {fileID: 8300000, guid: 81989ac4a95203742bb419ff9cbdea7d, type: 3}
    delayAfterLine: 1
    customMoveSpeed: 1
    customRotateSpeed: 1
  - speakerName: SUNDALO 1
    speakerColor: {r: 0.85, g: 0.85, b: 0.85, a: 1}
    dialogueText: At marami na sa atin ang pagod at nanghihina.
    cameraTarget: {fileID: 1441728290}
    voiceClip: {fileID: 8300000, guid: 4f3fb7fe32f1ca444a9285656f6c9ec4, type: 3}
    delayAfterLine: 1
    customMoveSpeed: 1
    customRotateSpeed: 1
  - speakerName: GOYO
    speakerColor: {r: 0.95, g: 0.75, b: 0.3, a: 1}
    dialogueText: Kaya hindi tayo maaaring magtagal dito. Pagkatapos nating magpahinga,
      tutungo tayo sa trail at susundan ito hanggang dulo.
    cameraTarget: {fileID: 36065401}
    voiceClip: {fileID: 8300000, guid: 9276c2cf1383afe4f90a1a800b4db1a2, type: 3}
    delayAfterLine: 1
    customMoveSpeed: 1
    customRotateSpeed: 1
  - speakerName: SUNDALO 2
    speakerColor: {r: 0.7, g: 0.85, b: 0.95, a: 1}
    dialogueText: At kung makita natin ang mga Amerikano?
    cameraTarget: {fileID: 28174540}
    voiceClip: {fileID: 8300000, guid: ea1f2e5561b779946991b5774433c7ef, type: 3}
    delayAfterLine: 1
    customMoveSpeed: 1
    customRotateSpeed: 1
  - speakerName: GOYO
    speakerColor: {r: 0.95, g: 0.75, b: 0.3, a: 1}
    dialogueText: Huwag kayong magpapadala sa takot. Harapin natin sila at alisin
      ang anumang haharang sa atin.
    cameraTarget: {fileID: 36065401}
    voiceClip: {fileID: 8300000, guid: c2ea27bf0713f4e4197ccced347109b6, type: 3}
    delayAfterLine: 1
    customMoveSpeed: 1
    customRotateSpeed: 1
  - speakerName: SUNDALO 1
    speakerColor: {r: 0.85, g: 0.85, b: 0.85, a: 1}
    dialogueText: Kailangan lang nating makarating sa dulo ng trail.
    cameraTarget: {fileID: 1441728290}
    voiceClip: {fileID: 8300000, guid: 51ab180463efa6940a4ebe0fe36833a4, type: 3}
    delayAfterLine: 1
    customMoveSpeed: 1
    customRotateSpeed: 1
  - speakerName: GOYO
    speakerColor: {r: 0.95, g: 0.75, b: 0.3, a: 1}
    dialogueText: Tama. Manatili kayong magkakasama at huwag mawawala sa grupo.
    cameraTarget: {fileID: 36065401}
    voiceClip: {fileID: 8300000, guid: 1cec64399ba9704419f35567aec3237f, type: 3}
    delayAfterLine: 1
    customMoveSpeed: 1
    customRotateSpeed: 1
  - speakerName: SUNDALO 2
    speakerColor: {r: 0.7, g: 0.85, b: 0.95, a: 1}
    dialogueText: Kung ganoon, magpahinga na tayo habang may oras pa.
    cameraTarget: {fileID: 28174540}
    voiceClip: {fileID: 8300000, guid: f462d747ecb6491428bf014dd8dd039f, type: 3}
    delayAfterLine: 1
    customMoveSpeed: 1
    customRotateSpeed: 1
  - speakerName: GOYO
    speakerColor: {r: 0.95, g: 0.75, b: 0.3, a: 1}
    dialogueText: Oo. Pagkatapos nito, aalis tayo. Maghanda kayo.
    cameraTarget: {fileID: 36065401}
    voiceClip: {fileID: 8300000, guid: 8db7b5e7a4e64824e861bcef6eb06108, type: 3}
    delayAfterLine: 1
    customMoveSpeed: 1
    customRotateSpeed: 1
  - speakerName: SUNDALO 1
    speakerColor: {r: 0.85, g: 0.85, b: 0.85, a: 1}
    dialogueText: Naiintindihan namin, Goyo.
    cameraTarget: {fileID: 1441728290}
    voiceClip: {fileID: 8300000, guid: 315ecafe9e5749448ba339dba8c0f402, type: 3}
    delayAfterLine: 1
    customMoveSpeed: 1
    customRotateSpeed: 1
  - speakerName: GOYO
    speakerColor: {r: 0.95, g: 0.75, b: 0.3, a: 1}
    dialogueText: Sa dilim man tayo maglakbay, makakarating tayo sa dulo. Walang
      maiiwan.
    cameraTarget: {fileID: 36065401}
    voiceClip: {fileID: 8300000, guid: 76e5f8ef5ef333e4c9aa7ab36de04878, type: 3}
    delayAfterLine: 2.5
    customMoveSpeed: 1
    customRotateSpeed: 1
